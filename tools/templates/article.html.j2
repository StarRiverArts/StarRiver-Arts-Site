{#
  ProjectT / Studio / Museum article page.

  One output page carries both languages, matching the rest of the site: the
  language selector and `html.lang-*` CSS decide which spans are visible. The
  two source Markdown files (one per language) are merged here rather than
  producing two URLs, so an article keeps a single canonical address.
#}
<!doctype html>
<!-- GENERATED-PAGE: built by tools/build_content.py from content/. Do not edit; edit the Markdown source. -->
<html lang="zh-TW" class="lang-zh sr-fluid">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title_zh }} | {{ site_label_zh }} | StarRiver Arts</title>
<meta name="description" content="{{ summary_zh }}">
<meta name="robots" content="{{ 'noindex,follow' if noindex else 'index,follow' }}">
<link rel="canonical" href="{{ canonical_url }}">
<meta property="og:title" content="{{ title_zh }}">
<meta property="og:description" content="{{ summary_zh }}">
<meta property="og:type" content="article">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:image" content="{{ base_url }}assets/logos/starriver-primary.png">
<meta name="twitter:card" content="summary">
<link rel="icon" href="{{ root }}assets/logos/starriver-primary.png">
<link rel="stylesheet" href="{{ root }}colors_and_type.css">
<link rel="stylesheet" href="{{ root }}ds-additions.css">
<link rel="stylesheet" href="{{ root }}play/play-landing.css">
<link rel="stylesheet" href="{{ root }}play/play-readability.css">
<link rel="stylesheet" href="{{ root }}play/article-prose.css">
<script type="application/ld+json">
{{ json_ld }}
</script>
<script type="text/javascript">
(function(c,l,a,r,i,t,y){
    c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
    t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
    y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
})(window, document, "clarity", "script", "{{ clarity_id }}");
</script>
</head>
<body>
<a class="skip-link" href="#main"><span class="zh">跳到主要內容</span><span class="en">Skip to content</span></a>

<nav class="nav">
  <a class="nav-home" href="{{ root }}">
    <span class="nav-brand">星河 STARRIVER ARTS</span>
  </a>
  <div class="nav-links">
    <a href="{{ root }}play/index.html"><span class="zh">Project T</span><span class="en">Project T</span></a>
    <a href="{{ list_href }}" class="active"><span class="zh">專欄</span><span class="en">Articles</span></a>
    <a href="{{ root }}play/RacingClub/TimeAttack/index.html"><span class="zh">Time Attack</span><span class="en">Time Attack</span></a>
  </div>
  <select class="lang-btn" id="lang" data-lang-select aria-label="語言 / Language">
    <option value="zh">中文</option>
    <option value="en">EN</option>
  </select>
</nav>

<main id="main" class="body-section">
  <div class="wrap">

    <a class="pa-back" href="{{ list_href }}">
      <span aria-hidden="true">←</span>
      <span class="zh">回到專欄</span><span class="en">Back to Articles</span>
    </a>

    <article class="pa-article">
      <header class="pa-lede">
        <div class="pa-kicker">
          <span class="zh">{{ category_label_zh }}</span><span class="en">{{ category_label_en }}</span>
        </div>
        <h1 class="pa-title">
          <span class="zh">{{ title_zh }}</span><span class="en">{{ title_en }}</span>
        </h1>
        <p class="pa-ledetext">
          <span class="zh">{{ summary_zh }}</span><span class="en">{{ summary_en }}</span>
        </p>

        <dl class="pa-spec">
          <div class="pa-spec-row">
            <dt class="pa-spec-k"><span class="zh">發布</span><span class="en">Published</span></dt>
            <dd class="pa-spec-v"><time datetime="{{ date }}">{{ date }}</time></dd>
          </div>
          <div class="pa-spec-row">
            <dt class="pa-spec-k"><span class="zh">內容查核</span><span class="en">Checked</span></dt>
            <dd class="pa-spec-v"><time datetime="{{ checked_at }}">{{ checked_at }}</time></dd>
          </div>
          {% for row in spec_rows %}
          <div class="pa-spec-row">
            <dt class="pa-spec-k"><span class="zh">{{ row.key_zh }}</span><span class="en">{{ row.key_en }}</span></dt>
            <dd class="pa-spec-v">{{ row.value }}</dd>
          </div>
          {% endfor %}
        </dl>
      </header>

      {% if disclosure_zh or viewpoint_zh %}
      <aside class="pa-disclosure" role="note">
        <p class="pa-disclosure-label">
          <span class="zh">關係與觀點聲明</span><span class="en">Relationship and viewpoint</span>
        </p>
        {% if disclosure_zh %}
        <p><span class="zh">{{ disclosure_zh }}</span><span class="en">{{ disclosure_en }}</span></p>
        {% endif %}
        {% if viewpoint_zh %}
        <p><span class="zh">{{ viewpoint_zh }}</span><span class="en">{{ viewpoint_en }}</span></p>
        {% endif %}
      </aside>
      {% endif %}

      {% if research_status %}
      <p class="pa-research-status">
        <span class="zh">研究狀態：{{ research_status_zh }}</span>
        <span class="en">Research status: {{ research_status }}</span>
      </p>
      {% endif %}

      <div class="pa-body zh">
{{ body_zh }}
      </div>

      <div class="pa-body en">
        {% if not has_en %}
        <p class="pa-untranslated" role="note">This article has not been translated yet. The Chinese text is shown below.</p>
        {% endif %}
{{ body_en }}
      </div>
    </article>

  </div>
</main>

<footer class="pa-footer">
  <div class="wrap">
    <p class="pa-credit">
      <span class="zh">網站由 StarRiver Arts 主導規劃與製作，並使用 OpenAI GPT 與 Anthropic Claude 協助資訊架構與網頁開發。</span>
      <span class="en">Planned and produced by StarRiver Arts, with OpenAI GPT and Anthropic Claude used to assist information architecture and web development.</span>
    </p>
  </div>
</footer>

<script>
(function () {
  "use strict";
  var html = document.documentElement;
  var select = document.getElementById("lang");
  var languages = ["zh", "en"];
  var htmlLang = { zh: "zh-TW", en: "en" };
  var saved = null;
  try { saved = localStorage.getItem("sr-lang"); } catch (error) { saved = null; }
  if (languages.indexOf(saved) === -1) saved = "zh";

  function setLanguage(language) {
    html.className = html.className.replace(/\blang-\w+\b/g, "").trim() + " lang-" + language;
    html.lang = htmlLang[language];
    try { localStorage.setItem("sr-lang", language); } catch (error) {}
    select.value = language;
  }

  setLanguage(saved);
  select.addEventListener("change", function () { setLanguage(select.value); });
})();
</script>
</body>
</html>
